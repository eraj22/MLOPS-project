# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Slack incoming webhook URL (Part 6)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/REAL_WEBHOOK

# Data source endpoint (Part 1) - DO NOT CHANGE / DO NOT CALL OTHER ENDPOINTS
RECORDS_API_URL=http://149.40.228.124:6500/records

# Polling interval in seconds for ingestion script
POLL_INTERVAL_SECONDS=30

# Drift detection threshold (relative change in mean, e.g. 0.20 = 20%)
DRIFT_THRESHOLD=0.20

# Minimum new records accumulated before considering retraining
RETRAIN_RECORD_THRESHOLD=200

# Target validation accuracy
TARGET_ACCURACY=0.80

# Max training iterations / hyperparameter attempts before giving up
MAX_TRAIN_ITERATIONS=10

# Inference API base URL (used by ingestion/retrain trigger to call /predict, /metrics)
INFERENCE_API_URL=http://localhost:8000

# AWS EC2 deployment (Part 3 / Part 7)
EC2_HOST=REPLACE_WITH_EC2_PUBLIC_IP
EC2_USER=ubuntu
DOCKER_IMAGE_NAME=yourdockerhubuser/mlops-inference
